<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.skuu.mapper.SkuuBlogMapper">

    <select id="selectPageList" resultType="cn.skuu.entity.SkuuBlog">
        select * from skuu_blog
        <where>
            <if test="skuuBlogPageDto.categary !=null">
                and categary = #{skuuBlogPageDto.categary}
            </if>
            and deleted = 0
        </where>
    </select>
</mapper>
